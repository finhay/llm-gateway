pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        skipDefaultCheckout(true)
    }

    parameters {
        string(name: 'RELEASE_TAG', defaultValue: '', description: 'Optional. Để trống thì Jenkins lấy tag từ GitHub Release webhook hoặc git tag mới nhất đã fetch.')
        string(name: 'RELEASE_TITLE', defaultValue: '', description: 'Optional. Nếu nhập thì dùng làm commit title deploy repo.')
        booleanParam(name: 'ALLOW_REBUILD_EXISTING_TAG', defaultValue: false, description: 'Prod nên để false. Nếu image tag đã tồn tại thì fail để giữ immutable release tag.')
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'WEBHOOK_RELEASE_ACTION', value: '$.action', expressionType: 'JSONPath', regexpFilter: '', defaultValue: ''],
                [key: 'WEBHOOK_RELEASE_TAG', value: '$.release.tag_name', expressionType: 'JSONPath', regexpFilter: '', defaultValue: ''],
                [key: 'WEBHOOK_RELEASE_TITLE', value: '$.release.name', expressionType: 'JSONPath', regexpFilter: '', defaultValue: ''],
                [key: 'WEBHOOK_REPO_FULL_NAME', value: '$.repository.full_name', expressionType: 'JSONPath', regexpFilter: '', defaultValue: ''],
                [key: 'WEBHOOK_RELEASE_TARGET', value: '$.release.target_commitish', expressionType: 'JSONPath', regexpFilter: '', defaultValue: '']
            ],

            causeString: 'GitHub release $WEBHOOK_RELEASE_ACTION: $WEBHOOK_RELEASE_TAG - $WEBHOOK_RELEASE_TITLE',

            token: '',
            tokenCredentialId: 'gwt-token-fhsc-github',

            printContributedVariables: true,
            printPostContent: false,
            silentResponse: false,
            shouldNotFlatten: false,

            // Case thường, tag dạng vX.Y.Z:
            // regexpFilterExpression: '^finhay-pro/vnsc-trading-api:published:v[0-9]+\\.[0-9]+\\.[0-9]+.*$'
            //
            regexpFilterText: '$WEBHOOK_REPO_FULL_NAME:$WEBHOOK_RELEASE_ACTION:$WEBHOOK_RELEASE_TARGET:$WEBHOOK_RELEASE_TAG',
            regexpFilterExpression: '^finhay/llm-gateway:published:master:v[0-9]+\\.[0-9]+\\.[0-9]+.*$'
        )
    }

    environment {
        APP_ENV = 'fh-production'
        DOCKERFILE = 'Dockerfile'

        IMAGE_NAME = 'finhay-llm-gateway'
        REGISTRY_URL = 'registry.vnsc.vn'

        DEPLOY_REPO_LOCAL_PATH = '/var/lib/jenkins/workspace/fhsc-k8s-deploy'
        DEPLOY_REPO_BRANCH = 'main'
        DEPLOY_REPO_PATH = 'finhay-prod-cls1/fh-production/llm-gateway'

        // Format: <deployment-file>:<container-name>
        // Ví dụ 1 deployment:
        // DEPLOYMENT_TARGETS = 'deployment.yaml:products-vnsc-accounts'
        //
        // Ví dụ 1 image update nhiều deployment:
        // DEPLOYMENT_TARGETS = 'deployment.yaml:container-a deployment-for-job.yaml:container-b'
        DEPLOYMENT_TARGETS = 'deployment.yaml:llm-gateway'

        ARGOCD_APP = 'llm-gateway'

        JENKINS_PUBLIC_URL = 'https://cicd.vinasecurities.com'

        NOTI_SCRIPT = './cicd_v2/send-noti-to-ggchat.sh'
        NOTI_ENVIRONMENT = 'finhay-prod-cls1/fh-production/llm-gateway'
    }

    stages {
        stage('Checkout source') {
            steps {
                checkout scm

                sh '''
set -eu

git fetch --tags --force || true

if [ -f "${NOTI_SCRIPT}" ]; then
  chmod +x "${NOTI_SCRIPT}" || true
fi
                '''

                stash(
                    name: 'ggchat-noti-script',
                    includes: 'cicd_v2/send-noti-to-ggchat.sh',
                    allowEmpty: true
                )
            }
        }

        stage('Resolve release tag') {
            steps {
                script {
                    env.IMAGE_VERSION = sh(
                        script: '''
set -eu

if [ -n "${WEBHOOK_RELEASE_TAG:-}" ]; then
  RESOLVED_TAG="${WEBHOOK_RELEASE_TAG}"
elif [ -n "${RELEASE_TAG:-}" ]; then
  RESOLVED_TAG="${RELEASE_TAG}"
else
  RESOLVED_TAG="$(git for-each-ref --sort=-creatordate --format='%(refname:short)' refs/tags | head -n 1 || true)"
fi

if [ -z "${RESOLVED_TAG}" ]; then
  echo "ERROR: Cannot resolve release tag. Please create GitHub Release, git tag, or input RELEASE_TAG." >&2
  echo "Available tags:" >&2
  git tag --sort=-creatordate | head -20 >&2 || true
  exit 1
fi

if ! git rev-parse -q --verify "refs/tags/${RESOLVED_TAG}" >/dev/null; then
  echo "ERROR: Git tag not found in local checkout: ${RESOLVED_TAG}" >&2
  echo "Available tags:" >&2
  git tag --sort=-creatordate | head -20 >&2 || true
  exit 1
fi

if ! echo "${RESOLVED_TAG}" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$'; then
  echo "ERROR: Invalid Docker image tag: ${RESOLVED_TAG}" >&2
  exit 1
fi

if [ "${RESOLVED_TAG}" = "latest" ]; then
  echo "ERROR: Do not use latest as release tag" >&2
  exit 1
fi

printf "%s" "${RESOLVED_TAG}"
                        ''',
                        returnStdout: true
                    ).trim()

                    env.FULL_IMAGE = "${env.REGISTRY_URL}/${env.IMAGE_NAME}:${env.IMAGE_VERSION}"
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.IMAGE_NAME}:${env.IMAGE_VERSION}"

                    echo "Webhook release action: ${env.WEBHOOK_RELEASE_ACTION ?: ''}"
                    echo "Webhook release tag: ${env.WEBHOOK_RELEASE_TAG ?: ''}"
                    echo "Webhook release title: ${env.WEBHOOK_RELEASE_TITLE ?: ''}"
                    echo "Resolved release tag: ${env.IMAGE_VERSION}"
                    echo "Full image: ${env.FULL_IMAGE}"
                }
            }
        }

        stage('Checkout release tag') {
            steps {
                sh '''
set -eu

git checkout -f "refs/tags/${IMAGE_VERSION}"

echo "Checked out release tag: ${IMAGE_VERSION}"
git log -1 --oneline
                '''

                unstash 'ggchat-noti-script'

                sh '''
set -eu

if [ -f "${NOTI_SCRIPT}" ]; then
  chmod +x "${NOTI_SCRIPT}" || true
  ls -lah "${NOTI_SCRIPT}"
else
  echo "WARN: Notification script not found after checkout tag: ${NOTI_SCRIPT}"
fi
                '''
            }
        }
        stage('Verify release tag is on master') {
            steps {
                sh '''
        set -eu
        
        if ! git show-ref --verify --quiet refs/remotes/origin/master; then
          echo "ERROR: origin/master not found in local checkout"
          echo "Need to fetch origin/master with GitHub credentials"
          git branch -r || true
          exit 1
        fi
        
        TAG_COMMIT="$(git rev-list -n 1 "${IMAGE_VERSION}")"
        
        if git merge-base --is-ancestor "${TAG_COMMIT}" "origin/master"; then
          echo "[INFO] Release tag ${IMAGE_VERSION} is on origin/master"
        else
          echo "ERROR: Release tag ${IMAGE_VERSION} is NOT on origin/master"
          echo "Tag commit: ${TAG_COMMIT}"
          echo "origin/master latest:"
          git log -1 --oneline origin/master || true
          exit 1
        fi
                '''
            }
        }
        stage('Resolve release metadata') {
            steps {
                script {
                    env.SOURCE_COMMIT = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
                    env.SOURCE_AUTHOR = sh(script: 'git log -1 --pretty=%an', returnStdout: true).trim()
                    env.SOURCE_COMMIT_MSG = sh(script: 'git log -1 --pretty=%s', returnStdout: true).trim()

                    env.OWNER_REPO = sh(
                        script: '''
set -eu

ORIGIN_URL="$(git config --get remote.origin.url || true)"

OWNER_REPO="$(
  printf "%s" "${ORIGIN_URL}" \
  | sed -E 's#^https://[^/]*github.com/##; s#^git@github.com:##; s#\\.git$##'
)"

case "${OWNER_REPO}" in
  */*) printf "%s" "${OWNER_REPO}" ;;
  *) printf "" ;;
esac
                        ''',
                        returnStdout: true
                    ).trim()

                    env.GITHUB_RELEASE_TITLE = sh(
                        script: '''
set -eu

TITLE=""

if [ -n "${OWNER_REPO:-}" ] && [ -n "${GITHUB_TOKEN:-}" ] && command -v curl >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
  API_JSON="$(curl -fsSL \
    -H "Authorization: Bearer ${GITHUB_TOKEN}" \
    -H "Accept: application/vnd.github+json" \
    "https://api.github.com/repos/${OWNER_REPO}/releases/tags/${IMAGE_VERSION}" 2>/dev/null || true)"

  if [ -n "${API_JSON}" ]; then
    TITLE="$(printf "%s" "${API_JSON}" | python3 -c 'import sys,json; data=json.load(sys.stdin); print((data.get("name") or "").replace("\\n"," ").replace("\\r"," ").strip())' 2>/dev/null || true)"
  fi
fi

printf "%s" "${TITLE}"
                        ''',
                        returnStdout: true
                    ).trim()

                    env.RESOLVED_RELEASE_TITLE = sh(
                        script: '''
set -eu

TITLE=""

if [ -n "${RELEASE_TITLE:-}" ]; then
  TITLE="${RELEASE_TITLE}"
elif [ -n "${WEBHOOK_RELEASE_TITLE:-}" ]; then
  TITLE="${WEBHOOK_RELEASE_TITLE}"
elif [ -n "${GITHUB_RELEASE_TITLE:-}" ]; then
  TITLE="${GITHUB_RELEASE_TITLE}"
else
  TITLE="$(git for-each-ref "refs/tags/${IMAGE_VERSION}" --format='%(contents:subject)' | head -n 1 || true)"

  if [ -z "${TITLE}" ]; then
    TITLE="${SOURCE_COMMIT_MSG}"
  fi
fi

if [ -z "${TITLE}" ]; then
  TITLE="deploy ${IMAGE_NAME} ${IMAGE_VERSION}"
fi

printf "%s" "${TITLE}" | tr '\\n\\r' '  '
                        ''',
                        returnStdout: true
                    ).trim()

                    echo "Owner repo: ${env.OWNER_REPO}"
                    echo "Image version: ${env.IMAGE_VERSION}"
                    echo "Full image: ${env.FULL_IMAGE}"
                    echo "Release title: ${env.RESOLVED_RELEASE_TITLE}"
                    echo "Source commit: ${env.SOURCE_COMMIT}"
                    echo "Source author: ${env.SOURCE_AUTHOR}"
                    echo "Source message: ${env.SOURCE_COMMIT_MSG}"
                }
            }
        }

        /*
        stage('Optional NodeJS build/test') {
            steps {
                sh '''
set -eu

node -v
npm -v

# Nếu dự án cần build ngoài Dockerfile thì uncomment/sửa theo project.
# npm ci
# npm run build
# npm test
                '''
            }
        }
        */

        stage('Check image tag exists') {
            steps {
                sh '''
set -eu

echo "Check image tag: ${FULL_IMAGE}"

if sudo docker manifest inspect "${FULL_IMAGE}" >/dev/null 2>&1; then
  echo "Image already exists: ${FULL_IMAGE}"

  if [ "${ALLOW_REBUILD_EXISTING_TAG:-false}" != "true" ]; then
    echo "ERROR: Image tag already exists. Release tag must be immutable."
    exit 1
  fi

  echo "ALLOW_REBUILD_EXISTING_TAG=true, continue rebuild existing tag."
else
  echo "Image tag does not exist, continue build."
fi
                '''
            }
        }

        stage('Build and push Docker image') {
            steps {
                sh '''
set -eu

echo "Build image: ${FULL_IMAGE}"
echo "NodeJS service: ${ARGOCD_APP}"

sudo docker build \
  -t "${IMAGE_NAME}:${IMAGE_VERSION}" \
  --build-arg NAME_SPACE="${APP_ENV}" \
  -f "${DOCKERFILE}" .

sudo docker tag "${IMAGE_NAME}:${IMAGE_VERSION}" "${FULL_IMAGE}"
sudo docker push "${FULL_IMAGE}"

sudo docker images "${REGISTRY_URL}/${IMAGE_NAME}" --digests || true
                '''
            }
        }

        stage('Update deploy repo for ArgoCD') {
            steps {
                sh '''
set -eu

DEPLOY_REPO="${DEPLOY_REPO_LOCAL_PATH}"
APP_PATH="${DEPLOY_REPO_PATH}"

LOCK_DIR="/tmp/fhsc-k8s-deploy.lockdir"
LOCK_WAIT=0

echo "[INFO] Deploy repo      : ${DEPLOY_REPO}"
echo "[INFO] App path         : ${APP_PATH}"
echo "[INFO] Full image       : ${FULL_IMAGE}"
echo "[INFO] Release tag      : ${IMAGE_VERSION}"
echo "[INFO] Release title    : ${RESOLVED_RELEASE_TITLE}"
echo "[INFO] Source commit    : ${SOURCE_COMMIT}"
echo "[INFO] Deployment targets:"

for TARGET in ${DEPLOYMENT_TARGETS}; do
  echo "  - ${TARGET}"
done

if [ ! -d "${DEPLOY_REPO}/.git" ]; then
  echo "ERROR: Deploy repo not found or not a git repo: ${DEPLOY_REPO}"
  exit 1
fi

if ! command -v yq >/dev/null 2>&1; then
  echo "ERROR: Missing yq on Jenkins agent"
  exit 1
fi

echo "[INFO] Acquire deploy repo lock: ${LOCK_DIR}"

while ! mkdir "${LOCK_DIR}" 2>/dev/null; do
  LOCK_WAIT=$((LOCK_WAIT + 5))

  if [ "${LOCK_WAIT}" -ge 300 ]; then
    echo "ERROR: Timeout waiting for deploy repo lock: ${LOCK_DIR}"
    exit 1
  fi

  echo "[INFO] Waiting for deploy repo lock... ${LOCK_WAIT}s"
  sleep 5
done

trap 'rmdir "${LOCK_DIR}" 2>/dev/null || true' EXIT INT TERM

cd "${DEPLOY_REPO}"

echo "[INFO] Sync local deploy repo with origin/${DEPLOY_REPO_BRANCH}"
git fetch origin "${DEPLOY_REPO_BRANCH}"
git checkout "${DEPLOY_REPO_BRANCH}"
git reset --hard "origin/${DEPLOY_REPO_BRANCH}"
git clean -fd

UPDATED_FILES=""

for TARGET in ${DEPLOYMENT_TARGETS}; do
  DEPLOYMENT_FILE_NAME="${TARGET%%:*}"
  TARGET_CONTAINER="${TARGET#*:}"

  if [ -z "${DEPLOYMENT_FILE_NAME}" ] || [ -z "${TARGET_CONTAINER}" ] || [ "${DEPLOYMENT_FILE_NAME}" = "${TARGET_CONTAINER}" ]; then
    echo "ERROR: Invalid DEPLOYMENT_TARGETS item: ${TARGET}"
    echo "Expected format: <deployment-file>:<container-name>"
    exit 1
  fi

  DEPLOYMENT_FILE="${DEPLOY_REPO}/${APP_PATH}/${DEPLOYMENT_FILE_NAME}"

  echo ""
  echo "[INFO] Processing target:"
  echo "  file      : ${DEPLOYMENT_FILE_NAME}"
  echo "  container : ${TARGET_CONTAINER}"
  echo "  path      : ${DEPLOYMENT_FILE}"

  if [ ! -f "${DEPLOYMENT_FILE}" ]; then
    echo "ERROR: deployment file not found: ${DEPLOYMENT_FILE}"
    exit 1
  fi

  echo "[INFO] Current images in ${DEPLOYMENT_FILE_NAME}:"
  yq e '.spec.template.spec.containers[] | {"name": .name, "image": .image}' "${DEPLOYMENT_FILE}"

  FOUND_CONTAINER="$(
    TARGET_CONTAINER="${TARGET_CONTAINER}" \
    yq e -r '.spec.template.spec.containers[] | select(.name == strenv(TARGET_CONTAINER)) | .name' \
    "${DEPLOYMENT_FILE}"
  )"

  if [ -z "${FOUND_CONTAINER}" ]; then
    echo "ERROR: Container not found in ${DEPLOYMENT_FILE_NAME}: ${TARGET_CONTAINER}"
    echo "Available containers:"
    yq e -r '.spec.template.spec.containers[].name' "${DEPLOYMENT_FILE}"
    exit 1
  fi

  TARGET_CONTAINER="${TARGET_CONTAINER}" FULL_IMAGE="${FULL_IMAGE}" \
  yq e -i '(.spec.template.spec.containers[] | select(.name == strenv(TARGET_CONTAINER)).image) = strenv(FULL_IMAGE)' \
    "${DEPLOYMENT_FILE}"

  echo "[INFO] Updated images in ${DEPLOYMENT_FILE_NAME}:"
  yq e '.spec.template.spec.containers[] | {"name": .name, "image": .image}' "${DEPLOYMENT_FILE}"

  UPDATED_FILES="${UPDATED_FILES} ${APP_PATH}/${DEPLOYMENT_FILE_NAME}"
done

echo ""
echo "[INFO] Git diff:"
git diff -- ${UPDATED_FILES} || true

if git diff --quiet -- ${UPDATED_FILES}; then
  echo "[INFO] No change in deploy repo. Skip commit."
  exit 0
fi

git config user.name "jenkins-release-bot"
git config user.email "jenkins-release-bot@fhsc.local"

git add ${UPDATED_FILES}

COMMIT_SUBJECT="${RESOLVED_RELEASE_TITLE}"

COMMIT_BODY="Image: ${FULL_IMAGE}
Release tag: ${IMAGE_VERSION}
Release title: ${RESOLVED_RELEASE_TITLE}
Source commit: ${SOURCE_COMMIT}
Source author: ${SOURCE_AUTHOR}
Source message: ${SOURCE_COMMIT_MSG}
Updated targets: ${DEPLOYMENT_TARGETS}
Jenkins build: ${JENKINS_PUBLIC_URL%/}/job/${JOB_NAME}/${BUILD_NUMBER}/
ArgoCD app: ${ARGOCD_APP}
Deploy path: ${DEPLOY_REPO_PATH}"

git commit -m "${COMMIT_SUBJECT}" -m "${COMMIT_BODY}"

echo "[INFO] Rebase before push"
git pull --rebase origin "${DEPLOY_REPO_BRANCH}"

echo "[INFO] Push deploy repo"
git push origin "${DEPLOY_REPO_BRANCH}"

echo "[DONE] Deploy repo updated. ArgoCD app will become OutOfSync."
                '''
            }
        }

        stage('Manual ArgoCD sync notice') {
            steps {
                echo """
                Deploy repo updated successfully.

                Jenkins does NOT deploy directly to Kubernetes.
                Jenkins only:
                  1. Resolves release tag
                  2. Checks out source by release tag
                  3. Builds image
                  4. Pushes image to registry
                  5. Updates fhsc-k8s-deploy

                Next step:
                  1. Open ArgoCD
                  2. App: ${ARGOCD_APP}
                  3. Refresh
                  4. Check Diff
                  5. Sync manually

                Image:
                  ${FULL_IMAGE}

                Release:
                  ${IMAGE_VERSION} - ${RESOLVED_RELEASE_TITLE}

                Deploy repo path:
                  ${DEPLOY_REPO_PATH}
                """
            }
        }
    }

    post {
        success {
            echo 'Jenkins build and deploy repo update completed successfully.'
            echo "ArgoCD app: ${ARGOCD_APP}"
            echo "Image: ${FULL_IMAGE}"
            echo "Release: ${IMAGE_VERSION} - ${RESOLVED_RELEASE_TITLE}"

            sh '''
set +e

BUILD_PATH="$(printf "%s" "${BUILD_URL:-}" | sed -E 's#^https?://[^/]+##')"

if [ -n "${BUILD_PATH}" ]; then
  PUBLIC_BUILD_URL="${JENKINS_PUBLIC_URL%/}${BUILD_PATH}"
else
  PUBLIC_BUILD_URL="${JENKINS_PUBLIC_URL%/}/job/${JOB_NAME}/${BUILD_NUMBER}/"
fi

if [ -f "${NOTI_SCRIPT}" ]; then
  chmod +x "${NOTI_SCRIPT}" || true

  bash "${NOTI_SCRIPT}" \
    "SUCCESS" \
    "${BUILD_NUMBER}" \
    "${FULL_IMAGE:-}" \
    "${NOTI_ENVIRONMENT}" \
    "${RESOLVED_RELEASE_TITLE:-}" \
    "${PUBLIC_BUILD_URL}" \
    "${SOURCE_AUTHOR:-}" \
    "${BRANCH_NAME:-}" \
    "${IMAGE_VERSION:-}" \
    "${ARGOCD_APP}" \
    "${DEPLOY_REPO_PATH}"
else
  echo "WARN: Notification script not found: ${NOTI_SCRIPT}"
fi
            '''
        }

        failure {
            echo 'Jenkins build or deploy repo update failed.'
            echo 'Check Jenkins console log.'

            sh '''
set +e

FULL_IMAGE_SAFE="${FULL_IMAGE:-${REGISTRY_URL:-}/${IMAGE_NAME:-}:${IMAGE_VERSION:-unknown}}"
MESSAGE_SAFE="${RESOLVED_RELEASE_TITLE:-${SOURCE_COMMIT_MSG:-Jenkins build failed}}"

BUILD_PATH="$(printf "%s" "${BUILD_URL:-}" | sed -E 's#^https?://[^/]+##')"

if [ -n "${BUILD_PATH}" ]; then
  PUBLIC_BUILD_URL="${JENKINS_PUBLIC_URL%/}${BUILD_PATH}"
else
  PUBLIC_BUILD_URL="${JENKINS_PUBLIC_URL%/}/job/${JOB_NAME}/${BUILD_NUMBER}/"
fi

if [ -f "${NOTI_SCRIPT}" ]; then
  chmod +x "${NOTI_SCRIPT}" || true

  bash "${NOTI_SCRIPT}" \
    "FAILURE" \
    "${BUILD_NUMBER}" \
    "${FULL_IMAGE_SAFE}" \
    "${NOTI_ENVIRONMENT}" \
    "${MESSAGE_SAFE}" \
    "${PUBLIC_BUILD_URL}" \
    "${SOURCE_AUTHOR:-}" \
    "${BRANCH_NAME:-}" \
    "${IMAGE_VERSION:-}" \
    "${ARGOCD_APP}" \
    "${DEPLOY_REPO_PATH}"
else
  echo "WARN: Notification script not found: ${NOTI_SCRIPT}"
fi
            '''
        }
    }
}
