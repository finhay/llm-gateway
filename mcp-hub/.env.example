# Public HTTPS origin of the hub (OAuth issuer + MCP endpoints live under it)
MCP_HUB_PUBLIC_URL=https://mcp.finhay.vn
PORT=20130
DATA_DIR=/app/data

# 32 random bytes, base64:  openssl rand -base64 32
MCP_HUB_VAULT_KEY=
# >= 32 chars:              openssl rand -hex 32
MCP_HUB_JWT_SECRET=

# Google Workspace OAuth client (Web application).
# Authorized redirect URI: ${MCP_HUB_PUBLIC_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MCP_HUB_ALLOWED_DOMAINS=finhay.com.vn

# Optional token lifetimes
# MCP_HUB_ACCESS_TTL_SEC=3600
# MCP_HUB_LOGIN_MAX_AGE_SEC=604800

# Services (endpoint enabled only when configured)
JIRA_BASE_URL=https://alex.finhay.com.vn
